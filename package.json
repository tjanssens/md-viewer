{
  "name": "md-viewer",
  "version": "2.0.3",
  "private": true,
  "description": "Fast Markdown viewer and editor for Windows and macOS",
  "author": "MD Viewer Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "watch:web": "node scripts/build-web.mjs --watch",
    "typecheck": "tsc --noEmit -p web",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm test && npm run test:rust && npm run build:web",
    "tauri": "tauri",
    "start": "tauri dev",
    "dist": "tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
